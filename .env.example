# Copy to .env only on your deployment server. Never commit real credentials.
RHYTHM_DOMAIN=rhythm.example.org
# Native Nginx only: TRUSTED_PROXY_CIDRS=127.0.0.1/32
# Leave empty for direct access. Trusted ingress must overwrite X-Real-IP.
# Never trust all networks; keep the application listener private.
TRUSTED_PROXY_CIDRS=
TELEGRAM_BOT_TOKEN=
# Optional server-only AI. Never put this key in browser code or a chat message.
# Empty selects the only configured key. If both exist, explicitly select one.
AI_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional 1..30 seconds; default DeepSeek=20, OpenAI=3.
AI_TIMEOUT_SECONDS=
# Global per-process paid-call ceiling; additionally 6 requests/user/10min, 4 concurrent.
AI_HOURLY_LIMIT=60
# Required for Compose PostgreSQL. Generate a unique random password locally.
POSTGRES_PASSWORD=
# For native/managed PostgreSQL (leave empty when using Compose):
# DATABASE_URL=postgres://rhythm_app@localhost:55432/rhythm?sslmode=disable
# Remote databases must use sslmode=verify-full and a trusted CA.
# Separate administrative password, used only by the database bootstrap.
POSTGRES_ADMIN_PASSWORD=
