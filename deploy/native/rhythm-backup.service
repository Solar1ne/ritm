[Unit]
Description=Private daily Rhythm PostgreSQL backup
After=postgresql@16-main.service
Requires=postgresql@16-main.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/opt/rhythm/current/deploy/backup.sh
EnvironmentFile=-/etc/rhythm/backup.env
TimeoutStartSec=17min
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/backups/rhythm
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
