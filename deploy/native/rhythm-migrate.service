[Unit]
Description=Apply Rhythm database migrations explicitly
After=postgresql@16-main.service
Requires=postgresql@16-main.service

[Service]
Type=oneshot
User=rhythm
Group=rhythm
EnvironmentFile=/etc/rhythm/app.env
ExecStart=/opt/rhythm/current/rhythm-db migrate
TimeoutStartSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
UMask=0077
