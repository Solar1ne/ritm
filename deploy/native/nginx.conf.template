# Included in nginx's http context. Do not put a CDN in front without reviewing
# real-IP trust and these quotas. Client headers are always overwritten below.
limit_req_zone $binary_remote_addr zone=rhythm_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=rhythm_auth:1m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=rhythm_conn:1m;
log_format rhythm '$time_iso8601 $request_method $uri $status $body_bytes_sent $request_time';

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name __RHYTHM_HOST__;
    server_tokens off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/rhythm-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 308 https://__RHYTHM_HOST__$request_uri; }
}

server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name __RHYTHM_HOST__;
    ssl_certificate /etc/letsencrypt/live/rhythm-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rhythm-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:RhythmTLS:5m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    server_tokens off;
    if ($host != __RHYTHM_HOST__) { return 421; }

    access_log /var/log/nginx/rhythm-access.log rhythm;
    error_log /var/log/nginx/rhythm-error.log warn;
    client_max_body_size 8m;
    client_body_timeout 15s;
    client_header_timeout 10s;
    keepalive_timeout 30s;
    limit_conn rhythm_conn 20;
    limit_conn_status 429;
    limit_req_status 429;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host __RHYTHM_HOST__;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 3s;
    proxy_read_timeout 45s;
    proxy_send_timeout 15s;
    # Mutations and paid AI calls are never retried by the proxy.
    proxy_next_upstream off;

    location /api/auth/ {
        limit_req zone=rhythm_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:8080;
    }
    location /api/ {
        limit_req zone=rhythm_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:8080;
    }
    location / { proxy_pass http://127.0.0.1:8080; }
}
